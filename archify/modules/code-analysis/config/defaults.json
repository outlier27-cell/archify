{
  "schema_version": 1,
  "include": [
    "**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
    "**/*.py",
    "**/*.java"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**/*.java",
    "**/coverage/**",
    "**/*.d.ts",
    "**/venv/**",
    "**/venv-*/**",
    "**/.venv/**",
    "**/site-packages/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.git/**",
    "**/_archive/**"
  ],
  "roles": {
    "test": [
      "**/test/**",
      "**/tests/**",
      "**/__tests__/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py"
    ],
    "generated": [
      "**/generated-*",
      "**/*.generated.*"
    ]
  },
  "rules": {
    "coupling": {
      "duplicateCode": {
        "enabled": false,
        "minTokens": 80,
        "minLines": 10
      }
    },
    "organization": {
      "mixedRoles": { "enabled": false },
      "folderRoles": { "enabled": false },
      "genericName": { "enabled": false }
    }
  }
}
