  "mainPath": ["open", "inspect", "copy", "share"],
  "nodes": [
    { "id": "open", "lane": "reader", "col": 0, "type": "frontend", "label": "Open artifact", "sublabel": "offline by default" },
    { "id": "inspect", "lane": "artifact", "col": 1, "width": 118, "type": "backend", "label": "Inspect identity", "sublabel": "type, version, digest" },
    { "id": "copy", "lane": "reader", "col": 2, "type": "frontend", "label": "Copy context", "sublabel": "reader initiated" },
    { "id": "share", "lane": "project", "col": 3, "width": 150, "type": "external", "label": "Open feedback form", "sublabel": "no automatic data transfer" }
  ],
  "edges": [
    { "from": "open", "to": "inspect" },
