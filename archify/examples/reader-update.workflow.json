{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Reader Update Notice Flow",
    "output": "examples/reader-update.workflow.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "reader", "label": "Reader" },
    { "id": "artifact", "label": "Standalone Artifact" },
    { "id": "release", "label": "Stable Release" }
  ],
  "mainPath": ["open", "inspect", "check", "notice"],
  "nodes": [
    { "id": "open", "lane": "reader", "col": 0, "type": "frontend", "label": "Open artifact", "sublabel": "offline by default" },
    { "id": "inspect", "lane": "artifact", "col": 1, "width": 120, "type": "backend", "label": "Inspect version", "sublabel": "local identity only" },
    { "id": "check", "lane": "reader", "col": 2, "width": 126, "type": "frontend", "label": "Check for update", "sublabel": "explicit click" },
    { "id": "notice", "lane": "artifact", "col": 3, "width": 150, "type": "messagebus", "label": "Show new version", "sublabel": "only when strictly verified" },
    { "id": "notes", "lane": "release", "col": 4, "width": 140, "type": "external", "label": "Open release notes", "sublabel": "reader initiated" }
  ],
  "edges": [
    { "from": "open", "to": "inspect" },
    { "from": "inspect", "to": "check" },
    { "from": "check", "to": "notice" },
    { "from": "notice", "to": "notes", "fromSide": "bottom", "toSide": "top" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Offline-first", "items": ["Loading the artifact does not fetch", "Development builds never claim to be current"] },
    { "dot": "cyan", "title": "Controlled disclosure", "items": ["One fixed stable manifest URL", "Version, summary and release link are strictly validated"] }
  ]
}
